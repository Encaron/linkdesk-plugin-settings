{
  "$schema": "./node_modules/@linkdesk/plugin-sdk/schemas/plugin.schema.json",
  "pluginId": "settings",
  "name": "设置",
  "version": "1.0.31",
  "minAppVersion": "0.2.32",
  "icon": "resources/icon-bar.svg",
  "marketIcon": "resources/icon.svg",
  "description": "软件设置——主题、语言、插件管理",
  "author": "官方",
  "distribution": "builtin",
  "core": true,
  "factoryRole": "settings",
  "entry": "src/index.tsx",
  "appearsIn": {
    "tabBar": true,
    "standaloneOpenable": true
  },
  "tabBehavior": {
    "singleton": true
  },
  "contributes": {
    "i18n": {
      "en": "i18n/en.json"
    },
    "viewsContainers": {
      "settings": {
        "title": "设置",
        "location": "auxiliarybar"
      }
    },
    "views": {
      "settings": [
        {
          "id": "settings",
          "title": "设置",
          "render": "src/views/SettingsView.tsx",
          "order": 0
        }
      ]
    },
    "floatingPanel": {
      "viewId": "settings",
      "formKey": "settings.openForm"
    },
    "commands": [
      {
        "id": "settings.editKeybinding",
        "title": "修改快捷键…",
        "description": "进入某条命令的快捷键编辑态（等于在「快捷键」页双击那一行）：先把设置页开出来并切到快捷键页，再按 command 指定要改哪条——不指定则弹命令选择器让使用者挑。⚠️ 只把那一行切进编辑态，新按键仍由使用者按（Enter 落地、Esc 取消）——不做「代按代存」。",
        "params": [
          {
            "name": "args",
            "type": "object",
            "required": false,
            "description": "{ command: string }——要改的命令 id（如 file-tree.openFile）；省略则弹选择器"
          }
        ]
      }
    ],
    "configuration": {
      "title": "设置插件",
      "properties": {
        "settings.openForm": {
          "type": "string",
          "title": "打开形态",
          "enum": [
            "floatingPanel",
            "tab"
          ],
          "enumDescriptions": {
            "floatingPanel": "悬浮面板",
            "tab": "标签页"
          },
          "default": "floatingPanel",
          "group": "打开方式",
          "description": "打开设置时的形态——floatingPanel 悬浮面板 / tab 标签页（只管第一次打开；打开之后仍可用面板右上角「在主窗口中打开」/ 标签页右键「在悬浮面板中打开」互相转换）"
        }
      }
    }
  }
}
